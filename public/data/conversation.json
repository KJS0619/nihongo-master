          "reading": "〜ともうします",
          "ko": "~라고 합니다",
          "usage": "자기 이름 소개 (겸양어)",
          "formality": "매우 정중"
        },
        {
          "ja": "どうぞよろしくお願いします",
          "reading": "どうぞよろしくおねがいします",
          "ko": "잘 부탁드립니다",
          "usage": "자기소개 마무리",
          "formality": "정중"
        }
      ],
      "vocabulary": [
        { "word": "自己紹介", "reading": "じこしょうかい", "meaning": "자기소개" },
