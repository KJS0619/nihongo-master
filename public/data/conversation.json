      "title": "자기소개",
      "titleJa": "自己紹介",
      "situation": "처음 만난 사람에게 자기소개하기",
      "description": "비즈니스나 일상에서 처음 만난 사람에게 자신을 소개하는 기본 표현",
      "jlpt": "N5",
      "category": "인사",
      "difficulty": 1,
      "estimatedTime": 3,
      "thumbnail": "👋",
      "dialogue": [
        {
          "id": 1,
          "speaker": "A",
          "speakerName": "田中",
          "speakerNameReading": "たなか",
          "ja": "はじめまして。田中と申します。",
          "reading": "はじめまして。たなかともうします。",
          "ko": "처음 뵙겠습니다. 다나카라고 합니다.",
          "note": "'と申します'는 '라고 합니다'의 겸양어"
        },
        {
          "id": 2,
          "speaker": "B",
          "speakerName": "キム",
          "speakerNameReading": "キム",
          "ja": "はじめまして。キムです。韓国から来ました。",
          "reading": "はじめまして。キムです。かんこくからきました。",
          "ko": "처음 뵙겠습니다. 김입니다. 한국에서 왔습니다.",
          "note": "'から来ました'로 출신지 표현"
