        "koreanComparison": "한국어 '~은/는 ~입니다'와 거의 동일한 구조입니다. 다만 일본어는 주어 생략이 더 자연스럽습니다.",
        "commonMistakes": [
          "'가/이'에 해당하는 'が'와 혼동하지 않도록 주의",
          "형용사 문장에서는 'です' 앞에 명사가 오지 않음"
        ]
      },
      "conjugation": {
        "polite_positive": { "form": "〜は〜です", "meaning": "~은/는 ~입니다" },
        "polite_negative": { "form": "〜は〜ではありません", "meaning": "~은/는 ~이/가 아닙니다" },
        "polite_past": { "form": "〜は〜でした", "meaning": "~은/는 ~이었습니다" },
        "polite_past_negative": { "form": "〜は〜ではありませんでした", "meaning": "~은/는 ~이/가 아니었습니다" },
        "casual_positive": { "form": "〜は〜だ", "meaning": "~은/는 ~이다" },
        "casual_negative": { "form": "〜は〜じゃない", "meaning": "~은/는 ~이/가 아니다" }
      },
      "examples": [
        {
          "ja": "私は学生です。",
          "reading": "わたしはがくせいです。",
          "ko": "저는 학생입니다.",
          "audio": null
        },
        {
          "ja": "田中さんは先生です。",
          "reading": "たなかさんはせんせいです。",
          "ko": "다나카 씨는 선생님입니다.",
          "audio": null
        },
        {
          "ja": "これは本です。",
