  "grammarPoints": [
    {
      "id": "g1",
      "pattern": "～という",
      "explanation": "'~라고 하는'이라는 의미로, 이름이나 명칭을 소개할 때 사용합니다.",
      "jlptLevel": "N4",
      "examples": [
        { "sentence": "浦島太郎という漁師", "reading": "うらしまたろうというりょうし", "translation": "우라시마 타로라는 어부" }
      ]
    },
    {
